{
	"name": "fxcanvas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"start": "npm run dev",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"previews:generate": "node scripts/generate-preview-sources.mjs",
		"smoke": "node scripts/smoke-test.mjs",
		"test:scenarios": "node scripts/scenario-test.mjs",
		"test": "npm run check && npm run build && npm run smoke && npm run test:scenarios"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"playwright": "^1.52.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
